{
  "name": "rebaseagent",
  "version": "0.3.0-k1",
  "private": true,
  "description": "ReBaseAgent — Agent 的时间旅行调试器。不止回放 Agent 做了什么，而是让你改变它做了什么。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pomelotea-yuzu/ReBaseAgent.git"
  },
  "homepage": "https://github.com/pomelotea-yuzu/ReBaseAgent#readme",
  "bugs": {
    "url": "https://github.com/pomelotea-yuzu/ReBaseAgent/issues"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "dev": "pnpm --filter @rebaseagent/desktop dev",
    "typecheck": "pnpm --filter @rebaseagent/desktop typecheck",
    "check:build": "pnpm --filter \"./packages/*\" build",
    "check:typecheck": "pnpm --filter @rebaseagent/desktop typecheck",
    "check:test": "pnpm -r test",
    "check:lint": "biome check .",
    "check:spec": "npx -y @fission-ai/openspec@1.12.0 validate --all --strict",
    "check:ci": "pnpm check:build && pnpm check:typecheck && pnpm check:test && pnpm check:lint && pnpm check:spec",
    "service:start": "node scripts/quiet-spawn-service.mjs ollama",
    "service:stop": "node scripts/quiet-spawn-service.mjs ollama --stop"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
