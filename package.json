{
  "name": "rebaseagent",
  "version": "0.2.0",
  "private": true,
  "description": "ReBaseAgent — Agent 的时间旅行调试器。不止回放 Agent 做了什么，而是让你改变它做了什么。",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "dev": "pnpm --filter @rebaseagent/desktop dev",
    "typecheck": "pnpm --filter @rebaseagent/desktop typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
