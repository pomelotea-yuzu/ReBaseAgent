{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "files": {
    "ignore": [
      "**/dist/**",
      "**/node_modules/**",
      "**/.pnpm-store/**",
      "**/.rebaseagent/**",
      "**/.workbuddy/**",
      "**/release/**",
      "**/*.timestamp-*.mjs",
      "**/electron.vite.config.*.mjs",
      "**/.tmp-*"
    ]
  },
  "overrides": [
    {
      "include": ["**/*.test.ts", "**/test/**"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noExportsInTest": "off" }
        }
      }
    }
  ]
}
