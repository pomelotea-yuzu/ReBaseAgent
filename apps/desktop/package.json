{
  "name": "@rebaseagent/desktop",
  "version": "0.1.0",
  "description": "ReBaseAgent 桌面调试台：本地查看 Agent 运行的完整轨迹（Electron 壳 + React）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.cjs",
