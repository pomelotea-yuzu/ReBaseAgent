  },
  "dependencies": {
    "@rebaseagent/agent-loop": "workspace:*",
    "@rebaseagent/trace-sdk": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
