{
  "name": "@rebaseagent/replay",
  "version": "0.1.0",
  "description": "ReBaseAgent 时间旅行最小切片：从已完成 run 派生分叉状态（前缀零 API）、校验可重放性、经 agent-loop 重跑并落盘 fork run",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
