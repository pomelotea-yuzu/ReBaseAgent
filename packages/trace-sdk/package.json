{
  "name": "@rebaseagent/trace-sdk",
  "version": "0.1.0",
  "description": "ReBaseAgent trace 格式 v1：zod schema、Tracer 事件流、JSONL 读写器与分支解析",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./workspace-hash": {
      "types": "./dist/workspace-hash.d.ts",
      "default": "./dist/workspace-hash.js"
    }
  },
  "files": ["dist", "fixtures"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
