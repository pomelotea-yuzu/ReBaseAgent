{
  "name": "@rebaseagent/project-verification",
  "version": "0.1.0",
  "description": "ReBaseAgent R3 项目验证：固定环境 manifest、验证计划/记录/结局 schema 与只读记录模块（执行器在后续任务接入）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
