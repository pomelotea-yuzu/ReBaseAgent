    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@rebaseagent/run-query": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@rebaseagent/trace-sdk": "workspace:*",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
