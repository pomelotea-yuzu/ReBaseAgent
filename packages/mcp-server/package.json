{
  "name": "@rebaseagent/mcp-server",
  "version": "0.1.0",
  "description": "ReBaseAgent 只读诊断 MCP 服务：stdio 子进程，显式数据根，零写入，事实与桌面同源",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
